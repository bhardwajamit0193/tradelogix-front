---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import SonnerToaster from '../components/react/SonnerToaster.jsx';
import PageProgressBar from '../components/common/PageProgressBar.astro';
import { fetchPlatformSettingsApi } from '../services/platformSettingsService.js';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  favicon?: string;
  noindex?: boolean;
}

const {
  title = 'TradeLogix | Next-Gen Tech & Electronics Storefront',
  description = 'Discover premium audio gear, OLED monitors, mechanical keyboards, and modern lifestyle tech accessories.',
  image = '/og-image.jpg',
  favicon: propFavicon,
  noindex = false,
} = Astro.props;

let resolvedFavicon = propFavicon;
if (!resolvedFavicon) {
  try {
    const platform = await fetchPlatformSettingsApi();
    if (platform && platform.favicon) {
      resolvedFavicon = platform.favicon;
    }
  } catch (e) {
    // fallback
  }
}

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:6543';
const formatIconUrl = (url: string | undefined) => {
  if (!url) return '/favicon.svg';
  if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('data:')) return url;
  if (url.startsWith('/uploads/')) return `${API_URL}${url}`;
  return url;
};

const finalFavicon = formatIconUrl(resolvedFavicon || '/favicon.svg');

let iconType = 'image/svg+xml';
if (finalFavicon.toLowerCase().endsWith('.png')) iconType = 'image/png';
else if (finalFavicon.toLowerCase().endsWith('.ico')) iconType = 'image/x-icon';
else if (finalFavicon.toLowerCase().endsWith('.jpg') || finalFavicon.toLowerCase().endsWith('.jpeg')) iconType = 'image/jpeg';
else if (finalFavicon.toLowerCase().endsWith('.webp')) iconType = 'image/webp';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type={iconType} href={finalFavicon} />
    <link rel="shortcut icon" href={finalFavicon} />
    <link rel="apple-touch-icon" href={finalFavicon} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    <!-- Astro View Transitions for SPA-like Instant Transitions -->
    <ViewTransitions fallback="animate" />

    <!-- Universal API Request Deduplication & In-Memory Response Caching Engine -->
    <script is:inline>
      (function() {
        if (typeof window === 'undefined' || window.__tradelogix_fetch_intercepted__) return;
        var nativeFetch = window.fetch;
        window.__nativeFetch__ = nativeFetch;
        var inFlight = new Map();
        var cache = new Map();
        var DEFAULT_TTL = 30000;
        var LONG_TTL_ENDPOINTS = [
          '/api/all-categories',
          '/api/settings/footer',
          '/api/admin/settings/footer',
          '/api/admin/settings/platform',
          '/api/pages'
        ];

        function getTtl(url) {
          var str = String(url || '');
          for (var i = 0; i < LONG_TTL_ENDPOINTS.length; i++) {
            if (str.indexOf(LONG_TTL_ENDPOINTS[i]) !== -1) return 60000;
          }
          return DEFAULT_TTL;
        }

        function getCacheKey(url, opts) {
          var method = (opts && opts.method ? opts.method : 'GET').toUpperCase();
          var urlStr = typeof url === 'string' ? url : (url && url.url ? url.url : String(url));
          var authKey = '';
          if (opts && opts.headers) {
            var h = opts.headers;
            var auth = typeof h.get === 'function' ? h.get('Authorization') : (h.Authorization || h.authorization);
            if (auth) authKey = ':' + String(auth).slice(-16);
          }
          return method + ':' + urlStr + authKey;
        }

        function invalidate(urlStr) {
          if (!urlStr) return;
          var clean = String(urlStr).split('?')[0];
          cache.forEach(function(val, key) {
            if (key.indexOf(clean) !== -1) cache.delete(key);
          });
        }

        window.fetch = function(url, options) {
          var opts = options || {};
          var method = (opts.method || 'GET').toUpperCase();

          // Mutations (POST, PUT, PATCH, DELETE) bypass cache and invalidate matching resources
          if (method !== 'GET' && method !== 'HEAD') {
            invalidate(typeof url === 'string' ? url : (url && url.url ? url.url : ''));
            return nativeFetch(url, options);
          }

          // Opt-out if requested
          if (opts.cache === 'no-store' || opts.cache === 'reload' || (opts.headers && opts.headers['x-no-cache'])) {
            return nativeFetch(url, options);
          }

          var key = getCacheKey(url, opts);
          var ttl = getTtl(url);

          // 1. Fresh cache hit -> return cloned Response immediately with 0 network calls
          var cached = cache.get(key);
          if (cached && (Date.now() - cached.timestamp < ttl)) {
            return Promise.resolve(new Response(cached.bodyText, {
              status: cached.status,
              statusText: cached.statusText,
              headers: new Headers(cached.headers)
            }));
          }

          // 2. Coalesce onto active in-flight request if already running
          if (inFlight.has(key)) {
            return inFlight.get(key).then(function(snap) {
              return new Response(snap.bodyText, {
                status: snap.status,
                statusText: snap.statusText,
                headers: new Headers(snap.headers)
              });
            });
          }

          // 3. Initiate single physical network fetch
          var p = nativeFetch(url, options).then(function(res) {
            return res.text().then(function(bodyText) {
              var headersObj = {};
              if (res.headers && typeof res.headers.forEach === 'function') {
                res.headers.forEach(function(v, k) { headersObj[k] = v; });
              }
              var snap = {
                bodyText: bodyText,
                status: res.status,
                statusText: res.statusText,
                headers: headersObj,
                timestamp: Date.now()
              };
              if (res.ok && res.status >= 200 && res.status < 300) {
                cache.set(key, snap);
              }
              return snap;
            });
          }).finally(function() {
            inFlight.delete(key);
          });

          inFlight.set(key, p);

          return p.then(function(snap) {
            return new Response(snap.bodyText, {
              status: snap.status,
              statusText: snap.statusText,
              headers: new Headers(snap.headers)
            });
          });
        };

        window.__tradelogix_fetch_intercepted__ = true;
        window.__clearApiCache__ = function() { cache.clear(); inFlight.clear(); };
        window.__apiCache__ = cache;
      })();

      function syncAuthClass() {
        try {
          var saved = localStorage.getItem('tradelogix_user');
          if (saved) {
            var u = JSON.parse(saved);
            if (u && u.isLoggedIn) {
              document.documentElement.classList.add('tradelogix-auth-active');
              return;
            }
          }
          document.documentElement.classList.remove('tradelogix-auth-active');
        } catch (e) {}
      }
      syncAuthClass();
      document.addEventListener('astro:page-load', syncAuthClass);

      // Safe global toast fallback before Sonner hydrates
      if (typeof window !== 'undefined' && !window.toastMessage) {
        window.toastMessage = function(msg, type) {
          if (window.toast) {
            var text = typeof msg === 'object' && msg !== null ? (msg.text || msg.message || JSON.stringify(msg)) : String(msg || '');
            if (type === 'error' && window.toast.error) window.toast.error(text);
            else if (type === 'warning' && window.toast.warning) window.toast.warning(text);
            else if (window.toast.success) window.toast.success(text);
          }
        };
      }
    </script>
  </head>
  <body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased selection:bg-brand-500 selection:text-white">
    <!-- Top Header Navigation Progress Bar -->
    <PageProgressBar />

    <!-- Ambient Background Glow Accents (Light Theme Pastels) -->
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl pointer-events-none -z-10 animate-pulse-slow"></div>
    <div class="fixed bottom-0 right-1/4 w-96 h-96 bg-accent-cyan/15 rounded-full blur-3xl pointer-events-none -z-10 animate-pulse-slow"></div>

    <slot />

    <!-- React Island: Global Floating Alerts (Sonner Top-Center) -->
    <SonnerToaster client:load transition:persist />
  </body>
</html>
