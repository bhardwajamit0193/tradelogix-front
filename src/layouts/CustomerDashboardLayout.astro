---
import BaseLayout from './BaseLayout.astro';
import CustomerDashboardSidebar from '../components/dashboard/CustomerDashboardSidebar.astro';
import CustomerDashboardHeader from '../components/dashboard/CustomerDashboardHeader.astro';

export interface Props {
  title?: string;
  headerTitle?: string;
  headerSubtitle?: string;
  pageTitle?: string;
  pageSubtitle?: string;
  activeTab?: string;
}

const {
  title = 'Customer Portal | TradeLogix',
  headerTitle = Astro.props.headerTitle || Astro.props.pageTitle || 'Customer Dashboard',
  headerSubtitle = Astro.props.headerSubtitle || Astro.props.pageSubtitle || 'Overview of your wholesale purchase orders, invoices, and business parameters',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title}>
  <!-- Instant client-side redirect if not authenticated or if Admin role -->
  <script is:inline>
    (function() {
      try {
        var raw = localStorage.getItem('tradelogix_user');
        if (!raw) {
          window.location.replace('/login?redirect=' + encodeURIComponent(window.location.pathname));
          return;
        }
        var u = JSON.parse(raw);
        if (!u?.accessToken) {
          window.location.replace('/login?redirect=' + encodeURIComponent(window.location.pathname));
          return;
        }
        if (u?.role === 'Admin') {
          window.location.replace('/admin');
        }
      } catch (e) {
        window.location.replace('/login');
      }
    })();
  </script>

  <div class="flex min-h-screen bg-slate-50">
    <!-- Left Sidebar (Desktop Static / Mobile Drawer) -->
    <CustomerDashboardSidebar currentPath={currentPath} />

    <!-- Main Content Stream -->
    <div class="flex-1 flex flex-col min-w-0 w-full">
      <CustomerDashboardHeader title={headerTitle} subtitle={headerSubtitle} />
      <main class="p-4 sm:p-6 lg:p-8 flex-1 overflow-y-auto min-w-0 w-full">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
