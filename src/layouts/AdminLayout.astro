---
import BaseLayout from './BaseLayout.astro';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import AdminHeader from '../components/admin/AdminHeader.astro';

export interface Props {
  title?: string;
  headerTitle?: string;
  headerSubtitle?: string;
}

const {
  title = 'TradeLogix Admin Panel',
  headerTitle = 'Admin Executive Dashboard',
  headerSubtitle = 'Real-time store metrics, inventory management, and customer orders',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title} noindex={true}>
  <script is:inline>
    (function() {
      try {
        const saved = localStorage.getItem('tradelogix_user');
        if (saved) {
          const user = JSON.parse(saved);
          if (user.isLoggedIn && user.role.toLowerCase() === 'admin') {
            return; // Authorized
          }
        }
      } catch (e) {
        console.error(e);
      }
      window.location.href = '/admin/login';
    })();
  </script>
  <div class="flex min-h-screen bg-slate-50">
    <!-- Left Sidebar (Desktop Static / Mobile Drawer) -->
    <AdminSidebar currentPath={currentPath} />

    <!-- Main Content Stream -->
    <div class="flex-1 flex flex-col min-w-0 w-full">
      <AdminHeader title={headerTitle} subtitle={headerSubtitle} />
      <main class="p-4 sm:p-6 lg:p-8 flex-1 overflow-y-auto min-w-0 w-full">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
