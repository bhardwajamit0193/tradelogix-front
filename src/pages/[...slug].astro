---
import ShopLayout from '../layouts/ShopLayout.astro';
import { fetchPageBySlugApi } from '../services/pagesService.js';

const { slug } = Astro.params;

// If slug is empty or home or standard routes that have dedicated files, let Astro handle them
if (!slug || slug === 'index' || slug === 'shop' || slug === 'admin' || slug === 'cart' || slug === 'checkout' || slug === 'login' || slug === 'register') {
  return Astro.redirect('/');
}

let page = null;
try {
  page = await fetchPageBySlugApi(slug);
} catch (e) {
  console.warn(`[CMS Dynamic Page] Could not load slug: ${slug}`, e.message);
}

if (!page || !page.isPublished) {
  return Astro.redirect('/404');
}

const pageTitle = page.metaTitle || page.title || 'TradeLogix Wholesale';
const pageDesc = page.metaDescription || `${page.title} - TradeLogix Wholesale B2B Commerce Platform`;

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:6543';
const resolveMediaUrl = (url) => {
  if (!url) return '';
  if (url.startsWith('/uploads/')) return `${API_URL}${url}`;
  return url;
};
---

<ShopLayout
  title={pageTitle}
  description={pageDesc}
  image={page.metaImage ? resolveMediaUrl(page.metaImage) : undefined}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-8">
    <!-- Header Banner -->
    <div class="border-b border-slate-200 pb-8 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-bold uppercase tracking-wider">
        <span class="material-symbols-outlined text-[16px]">article</span>
        <span>{page.navLabel || 'TradeLogix Document'}</span>
      </div>
      <h1 class="font-display font-black text-3xl sm:text-5xl text-slate-900 tracking-tight">
        {page.title}
      </h1>
      {page.updatedAt && (
        <p class="text-xs text-slate-400">
          Last updated: {new Date(page.updatedAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
      )}
    </div>

    <!-- Render Dynamic Content -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-xs">
      <article
        class="prose prose-slate max-w-none text-xs sm:text-sm leading-relaxed text-slate-700 space-y-4"
        set:html={page.content || '<p class="text-slate-400 italic">No content has been published for this page yet.</p>'}
      />
    </div>
  </div>
</ShopLayout>
