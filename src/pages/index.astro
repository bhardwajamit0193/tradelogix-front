---
import ShopLayout from '../layouts/ShopLayout.astro';
import { PRODUCTS, getFeaturedProducts } from '../services/productService.js';
import ProductCard from '../components/react/ProductCard.jsx';

const featuredProducts = getFeaturedProducts();

const categoriesGrid = [
  { name: 'Audio & Sound', icon: 'headphones', category: 'Audio' },
  { name: 'Monitors & Displays', icon: 'desktop_windows', category: 'Displays' },
  { name: 'Keyboards & Mice', icon: 'keyboard', category: 'Peripherals' },
  { name: 'Smart Wearables', icon: 'watch', category: 'Wearables' },
  { name: 'Home & Desk Lamps', icon: 'light', category: 'Home & Office' },
  { name: 'NVMe Storage', icon: 'hard_drive', category: 'Storage' },
  { name: 'Networking & Docks', icon: 'hub', category: 'Peripherals' },
  { name: 'Tech Accessories', icon: 'tune', category: 'All' },
];
---

<ShopLayout title="TradeLogix | Enterprise Hardware & Next-Gen Tech Solutions">
  <div class="space-y-12 pb-16">
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <div class="relative glass-panel rounded-3xl overflow-hidden shadow-xl flex flex-col lg:flex-row min-h-[500px] border border-slate-200/80 bg-white">
        <!-- Content Side -->
        <div class="flex-1 p-8 md:p-12 flex flex-col justify-center bg-gradient-to-br from-brand-50/70 via-white to-slate-50">
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-brand-50 text-brand-700 border border-brand-200">
              <span class="w-2 h-2 rounded-full bg-brand-600 animate-ping mr-2"></span> Enterprise Ready
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
              Bulk Tier & Retail Available
            </span>
          </div>

          <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-slate-900 mb-4 leading-tight">
            Enterprise Tech & <br />
            <span class="gradient-text">Hardware Solutions</span>
          </h1>

          <p class="text-slate-600 text-sm sm:text-base mb-8 max-w-xl leading-relaxed">
            Equip your workforce with high-performance audio, 240Hz curved OLED displays, hot-swappable mechanical keyboards, and precision peripherals. Verified OEM partnerships guarantee reliability.
          </p>

          <!-- Feature Specs Pills -->
          <div class="flex flex-wrap gap-2.5 mb-8">
            <span class="px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-800 shadow-sm flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-brand-600">headphones</span> Titanium ANC
            </span>
            <span class="px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-800 shadow-sm flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-cyan-600">monitor</span> 240Hz OLED
            </span>
            <span class="px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-800 shadow-sm flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-amber-600">keyboard</span> Hot-Swap Mechanical
            </span>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="/shop"
              class="px-8 py-3.5 rounded-xl gradient-brand text-white font-display font-bold text-xs shadow-md hover:scale-[1.02] transition-all flex items-center gap-2"
            >
              Request Quote / Buy <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
            <a
              href="/shop"
              class="px-6 py-3.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-800 font-display font-semibold text-xs hover:bg-slate-200 transition-all"
            >
              Explore Catalog
            </a>
          </div>
        </div>

        <!-- Image Side -->
        <div class="flex-1 relative min-h-[300px] lg:min-h-full bg-slate-100 overflow-hidden group">
          <img
            src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=1000&auto=format&fit=crop&q=80"
            alt="Flagship Hardware Banner"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-50 via-transparent to-transparent lg:bg-gradient-to-l lg:from-transparent lg:to-slate-50"></div>
          
          <div class="absolute bottom-6 left-6 right-6 glass-panel p-4 rounded-2xl border border-slate-200/80 bg-white/90 backdrop-blur-md shadow-lg">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-[10px] font-bold text-brand-600 uppercase tracking-wider">Flagship Hardware</span>
                <h4 class="font-display font-bold text-slate-900 text-sm">AeroPulse ANC Headphones</h4>
              </div>
              <span class="font-display font-extrabold text-base text-slate-900">₹299.99</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Value Props Icon Bar -->
    <section class="border-y border-slate-200 bg-slate-100/70 py-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 divide-y sm:divide-y-0 sm:divide-x divide-slate-200">
          <!-- Prop 1 -->
          <div class="flex items-center gap-4 px-4 pt-4 sm:pt-0">
            <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 border border-brand-200 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">verified</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Verified OEM Hardware</h3>
              <p class="text-xs text-slate-500">Direct from top manufacturers</p>
            </div>
          </div>

          <!-- Prop 2 -->
          <div class="flex items-center gap-4 px-4 pt-4 sm:pt-0">
            <div class="w-12 h-12 rounded-2xl bg-cyan-50 text-cyan-600 border border-cyan-200 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">leaderboard</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Tiered Bulk Pricing</h3>
              <p class="text-xs text-slate-500">Scale savings on high volume</p>
            </div>
          </div>

          <!-- Prop 3 -->
          <div class="flex items-center gap-4 px-4 pt-4 sm:pt-0">
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 border border-amber-200 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">support_agent</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Dedicated Account Rep</h3>
              <p class="text-xs text-slate-500">1-on-1 personalized support</p>
            </div>
          </div>

          <!-- Prop 4 -->
          <div class="flex items-center gap-4 px-4 pt-4 sm:pt-0">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">local_shipping</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Insured Global Freight</h3>
              <p class="text-xs text-slate-500">Fast B2B & Retail shipping</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Category Circles Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-8">
        <h2 class="font-display font-extrabold text-2xl text-slate-900">Browse Hardware Categories</h2>
        <p class="text-xs text-slate-500 mt-1">Select a category to filter inventory and bulk tiers.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4">
        {categoriesGrid.map((cat) => (
          <a
            href={`/shop?category=${cat.category}`}
            class="group flex flex-col items-center gap-3 p-3 rounded-2xl glass-panel bg-white border border-slate-200 hover:border-brand-300 hover:shadow-md hover:-translate-y-1 transition-all duration-300 shadow-sm"
          >
            <div class="w-16 h-16 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-brand-600 group-hover:bg-brand-600 group-hover:text-white transition-all shadow-sm">
              <span class="material-symbols-outlined text-[28px]">{cat.icon}</span>
            </div>
            <span class="text-xs font-semibold text-slate-700 text-center group-hover:text-slate-900 transition-colors line-clamp-1">
              {cat.name}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Product Shelves: Trending Hardware -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 border-b border-slate-200 pb-4">
        <div>
          <h2 class="font-display font-extrabold text-2xl text-slate-900">Trending Bulk & Retail Hardware</h2>
          <p class="text-xs text-slate-500 mt-1">Verified current product inventory ready for immediate fulfillment.</p>
        </div>
        <a href="/shop" class="text-xs font-semibold text-brand-600 hover:text-brand-700 flex items-center gap-1">
          View All Products <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
      </div>

      <!-- Shared Product Card Component -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {PRODUCTS.map((product) => (
          <ProductCard client:load product={product} />
        ))}
      </div>
    </section>

    <!-- Promotional Sale Banner -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden shadow-xl gradient-brand grid grid-cols-1 md:grid-cols-2 items-center min-h-[340px]">
        {/* Left Column Text & CTA */}
        <div class="p-8 sm:p-12 space-y-4 z-10 text-white">
          <span class="px-3 py-1 rounded-full bg-white/20 text-white text-xs font-bold uppercase tracking-wider backdrop-blur-sm">
            Limited Volume Promotion
          </span>
          <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white leading-tight">
            Mid-Season Hardware Sale
          </h2>
          <p class="text-indigo-100 text-xs sm:text-sm leading-relaxed">
            Upgrade your corporate IT infrastructure with substantial volume discounts. Apply code <strong class="text-white bg-white/20 px-2 py-0.5 rounded font-mono">WELCOME20</strong> for an instant 20% discount.
          </p>
          <a
            href="/shop"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-white text-brand-700 font-display font-bold text-xs shadow-md hover:bg-slate-100 transition-all"
          >
            Shop Sale Catalog <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>

        {/* Right Column Showcase Image */}
        <div class="relative h-full min-h-[260px] overflow-hidden bg-slate-900">
          <img
            src="https://images.unsplash.com/photo-1593642632823-8f785ba67e45?w=1000&auto=format&fit=crop&q=80"
            alt="Hardware Sale Showcase"
            class="w-full h-full object-cover opacity-90"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-brand-600 via-transparent to-transparent hidden md:block"></div>
        </div>
      </div>
    </section>
  </div>
</ShopLayout>
