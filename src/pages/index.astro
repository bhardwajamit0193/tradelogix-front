---
import ShopLayout from '../layouts/ShopLayout.astro';
import { PRODUCTS, getFeaturedProducts } from '../services/productService.js';
import ProductCard from '../components/react/ProductCard.jsx';

const featuredProducts = getFeaturedProducts();

const categoriesGrid = [
  { name: 'Audio & Sound', icon: 'headphones', category: 'Audio' },
  { name: 'Monitors & Displays', icon: 'desktop_windows', category: 'Displays' },
  { name: 'Keyboards & Mice', icon: 'keyboard', category: 'Peripherals' },
  { name: 'Smart Wearables', icon: 'watch', category: 'Wearables' },
  { name: 'Home & Desk Lamps', icon: 'light', category: 'Home & Office' },
  { name: 'NVMe Storage', icon: 'hard_drive', category: 'Storage' },
  { name: 'Networking & Docks', icon: 'hub', category: 'Peripherals' },
  { name: 'Tech Accessories', icon: 'tune', category: 'All' },
];
---

<ShopLayout title="TradeLogix | Enterprise Hardware & Next-Gen Tech Solutions">
  <div class="space-y-12 pb-16">
    <!-- Hero Section (Matching docs/home.html design layout) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <div class="relative glass-panel rounded-3xl overflow-hidden shadow-2xl flex flex-col lg:flex-row min-h-[500px] border border-white/10">
        <!-- Content Side -->
        <div class="flex-1 p-8 md:p-12 flex flex-col justify-center bg-gradient-to-br from-gray-900/90 via-[#0b0f19]/80 to-gray-950">
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-brand-500/20 text-brand-300 border border-brand-500/30 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-brand-400 animate-ping mr-2"></span> Enterprise Ready
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-white/5 text-gray-300 border border-white/10">
              Bulk Tier & Retail Available
            </span>
          </div>

          <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-white mb-4 leading-tight">
            Enterprise Tech & <br />
            <span class="gradient-text">Hardware Solutions</span>
          </h1>

          <p class="text-gray-300 text-sm sm:text-base mb-8 max-w-xl leading-relaxed">
            Equip your workforce with high-performance audio, 240Hz curved OLED displays, hot-swappable mechanical keyboards, and precision peripherals. Verified OEM partnerships guarantee reliability.
          </p>

          <!-- Feature Specs Pills -->
          <div class="flex flex-wrap gap-2.5 mb-8">
            <span class="px-3 py-1.5 rounded-xl bg-gray-900/90 border border-white/10 text-xs font-semibold text-gray-200 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-brand-400">headphones</span> Titanium ANC
            </span>
            <span class="px-3 py-1.5 rounded-xl bg-gray-900/90 border border-white/10 text-xs font-semibold text-gray-200 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-accent-cyan">monitor</span> 240Hz OLED
            </span>
            <span class="px-3 py-1.5 rounded-xl bg-gray-900/90 border border-white/10 text-xs font-semibold text-gray-200 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-amber-400">keyboard</span> Hot-Swap Mechanical
            </span>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="/shop"
              class="px-8 py-3.5 rounded-xl gradient-brand text-white font-display font-bold text-xs shadow-glow-primary hover:scale-[1.02] transition-all flex items-center gap-2"
            >
              Request Quote / Buy <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
            <a
              href="/shop"
              class="px-6 py-3.5 rounded-xl bg-gray-900 border border-white/10 text-gray-200 font-display font-semibold text-xs hover:text-white hover:border-white/20 transition-all"
            >
              Explore Catalog
            </a>
          </div>
        </div>

        <!-- Image Side -->
        <div class="flex-1 relative min-h-[300px] lg:min-h-full bg-gray-950 overflow-hidden group">
          <img
            src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=1000&auto=format&fit=crop&q=80"
            alt="Flagship Hardware Banner"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0b0f19] via-transparent to-transparent lg:bg-gradient-to-l lg:from-transparent lg:to-[#0b0f19]"></div>
          
          <div class="absolute bottom-6 left-6 right-6 glass-panel p-4 rounded-2xl border border-white/10 backdrop-blur-md">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-[10px] font-bold text-brand-400 uppercase tracking-wider">Flagship Hardware</span>
                <h4 class="font-display font-bold text-white text-sm">AeroPulse ANC Headphones</h4>
              </div>
              <span class="font-display font-extrabold text-base text-white">₹299.99</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Value Props Icon Bar (4 Columns matching docs/home.html) -->
    <section class="border-y border-white/10 bg-gray-950/60 py-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 divide-y sm:divide-y-0 sm:divide-x divide-white/10">
          <!-- Prop 1 -->
          <div class="flex items-center gap-4 px-4 pt-4 sm:pt-0">
            <div class="w-12 h-12 rounded-2xl bg-brand-500/20 text-brand-400 border border-brand-500/30 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">verified</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-white">Verified OEM Hardware</h3>
              <p class="text-xs text-gray-400">Direct from top manufacturers</p>
            </div>
          </div>

          <!-- Prop 2 -->
          <div class="flex items-center gap-4 px-4 pt-4 sm:pt-0">
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">leaderboard</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-white">Tiered Bulk Pricing</h3>
              <p class="text-xs text-gray-400">Scale savings on high volume</p>
            </div>
          </div>

          <!-- Prop 3 -->
          <div class="flex items-center gap-4 px-4 pt-4 sm:pt-0">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">support_agent</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-white">Dedicated Account Rep</h3>
              <p class="text-xs text-gray-400">1-on-1 personalized support</p>
            </div>
          </div>

          <!-- Prop 4 -->
          <div class="flex items-center gap-4 px-4 pt-4 sm:pt-0">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">local_shipping</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-white">Insured Global Freight</h3>
              <p class="text-xs text-gray-400">Fast B2B & Retail shipping</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Category Circles Grid (8 Items matching docs/home.html) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-8">
        <h2 class="font-display font-extrabold text-2xl text-white">Browse Hardware Categories</h2>
        <p class="text-xs text-gray-400 mt-1">Select a category to filter inventory and bulk tiers.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4">
        {categoriesGrid.map((cat) => (
          <a
            href={`/shop?category=${cat.category}`}
            class="group flex flex-col items-center gap-3 p-3 rounded-2xl glass-panel border border-white/5 hover:border-brand-500/40 hover:-translate-y-1 transition-all duration-300"
          >
            <div class="w-16 h-16 rounded-full bg-gray-900 border border-white/10 flex items-center justify-center text-brand-400 group-hover:bg-brand-600 group-hover:text-white transition-all shadow-glow-primary">
              <span class="material-symbols-outlined text-[28px]">{cat.icon}</span>
            </div>
            <span class="text-xs font-semibold text-gray-300 text-center group-hover:text-white transition-colors line-clamp-1">
              {cat.name}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Product Shelves: Trending Hardware (Using Shared ProductCard Component) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 border-b border-white/10 pb-4">
        <div>
          <h2 class="font-display font-extrabold text-2xl text-white">Trending Bulk & Retail Hardware</h2>
          <p class="text-xs text-gray-400 mt-1">Verified current product inventory ready for immediate fulfillment.</p>
        </div>
        <a href="/shop" class="text-xs font-semibold text-brand-400 hover:text-brand-300 flex items-center gap-1">
          View All Products <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
      </div>

      <!-- Shared Product Card Component (Same UI as Shop page) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {PRODUCTS.map((product) => (
          <ProductCard client:load product={product} />
        ))}
      </div>
    </section>

    <!-- Promotional Sale Banner (Matching docs/home.html) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative glass-panel rounded-3xl overflow-hidden shadow-2xl border border-white/10 grid grid-cols-1 md:grid-cols-2 items-center min-h-[340px]">
        {/* Left Column Text & CTA */}
        <div class="p-8 sm:p-12 space-y-4 z-10">
          <span class="px-3 py-1 rounded-full bg-brand-500/20 text-brand-300 text-xs font-bold uppercase tracking-wider border border-brand-500/30">
            Limited Volume Promotion
          </span>
          <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white leading-tight">
            Mid-Season Hardware Sale
          </h2>
          <p class="text-gray-300 text-xs sm:text-sm leading-relaxed">
            Upgrade your corporate IT infrastructure with substantial volume discounts. Apply code <strong class="text-white bg-white/10 px-2 py-0.5 rounded font-mono">WELCOME20</strong> for an instant 20% discount.
          </p>
          <a
            href="/shop"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl gradient-brand text-white font-display font-bold text-xs shadow-glow-primary hover:scale-[1.02] transition-all"
          >
            Shop Sale Catalog <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>

        {/* Right Column Showcase Image */}
        <div class="relative h-full min-h-[260px] overflow-hidden bg-gray-950">
          <img
            src="https://images.unsplash.com/photo-1593642632823-8f785ba67e45?w=1000&auto=format&fit=crop&q=80"
            alt="Hardware Sale Showcase"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-[#0b0f19] via-transparent to-transparent hidden md:block"></div>
        </div>
      </div>
    </section>
  </div>
</ShopLayout>
