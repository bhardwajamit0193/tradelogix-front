---
import ShopLayout from '../layouts/ShopLayout.astro';
import CategoriesBar from '../components/react/CategoriesBar.jsx';
import HeroBannerSlider from '../components/react/HeroBannerSlider.jsx';
import ProductCard from '../components/react/ProductCard.jsx';
import {
  fetchSectionProducts,
  fetchShopCategoriesApi,
} from '../services/productService.js';
import { fetchPageBySlugApi, parseHomeSections } from '../services/pagesService.js';

let homePage = null;
try {
  homePage = await fetchPageBySlugApi('home');
} catch (e) {
  // fallback to defaults
}

const sections = parseHomeSections(homePage?.content);

// Fetch live database categories and products for all sections simultaneously
const [liveCategories, latestProducts, featuredProducts, topSellingProducts, trendingProducts] = await Promise.all([
  fetchShopCategoriesApi(),
  fetchSectionProducts(sections.latestProducts, 'latest'),
  fetchSectionProducts(sections.featuredProducts, 'featured'),
  fetchSectionProducts(sections.topSellingProducts, 'top-selling'),
  fetchSectionProducts(sections.trendingProducts, 'trending'),
]);

const pageTitle = homePage?.metaTitle || 'TradeLogix Wholesale | Enterprise Hardware & B2B Tech Distribution';
const pageDescription = homePage?.metaDescription || 'Direct B2B wholesale electronics distribution platform with verified GST ITC invoices and tier volume pricing.';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:6543';
const resolveMediaUrl = (url) => {
  if (!url) return '';
  if (url.startsWith('/uploads/')) return `${API_URL}${url}`;
  return url;
};
---

<ShopLayout
  title={pageTitle}
  description={pageDescription}
  image={homePage?.metaImage ? resolveMediaUrl(homePage.metaImage) : undefined}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16 py-6 sm:py-8">

    {/* ========================================================================= */}
    {/* 1. SHOW ALL CATEGORIES BELOW SEARCH                                       */}
    {/* ========================================================================= */}
    {sections.categoriesBar?.enabled && (
      <CategoriesBar
        client:load
        mode={sections.categoriesBar?.mode || 'all'}
        selectedCategoryIds={sections.categoriesBar?.selectedCategoryIds || []}
        initialCategories={liveCategories}
      />
    )}

    {/* ========================================================================= */}
    {/* 2. CLICKABLE SLIDER BANNER                                                */}
    {/* ========================================================================= */}
    {sections.heroSlider?.enabled && (
      <section>
        <HeroBannerSlider client:load slides={sections.heroSlider?.slides} />
      </section>
    )}

    {/* ========================================================================= */}
    {/* 3. LATEST PRODUCTS                                                        */}
    {/* ========================================================================= */}
    {sections.latestProducts?.enabled && (
      <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-slate-200 pb-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase tracking-wider">
                {sections.latestProducts.badge || 'New Arrivals'}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            </div>
            <h2 class="text-xl sm:text-2xl font-display font-extrabold text-slate-900 tracking-tight">
              {sections.latestProducts.title || 'Latest Hardware Releases'}
            </h2>
            <p class="text-xs text-slate-500">
              {sections.latestProducts.subtitle || 'Freshly added OEM models ready for pallet allocation and immediate dispatch.'}
            </p>
          </div>

          <a
            href={sections.latestProducts.viewAllLink || '/shop?sort=newest'}
            class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:text-brand-800 hover:underline transition-all self-start sm:self-auto"
          >
            <span>View All Latest</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {latestProducts.map((product) => (
            <ProductCard client:load product={product} />
          ))}
        </div>
      </section>
    )}

    {/* ========================================================================= */}
    {/* 4. FEATURED PRODUCTS                                                      */}
    {/* ========================================================================= */}
    {sections.featuredProducts?.enabled && (
      <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-slate-200 pb-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-md bg-brand-100 text-brand-800 text-[10px] font-bold uppercase tracking-wider">
                {sections.featuredProducts.badge || 'Staff Curated'}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
            </div>
            <h2 class="text-xl sm:text-2xl font-display font-extrabold text-slate-900 tracking-tight">
              {sections.featuredProducts.title || 'Featured OEM Hardware'}
            </h2>
            <p class="text-xs text-slate-500">
              {sections.featuredProducts.subtitle || 'High-demand displays, mechanical keyboards, and precision audio units with volume discount tiering.'}
            </p>
          </div>

          <a
            href={sections.featuredProducts.viewAllLink || '/shop'}
            class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:text-brand-800 hover:underline transition-all self-start sm:self-auto"
          >
            <span>View All Featured</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredProducts.map((product) => (
            <ProductCard client:load product={product} />
          ))}
        </div>
      </section>
    )}

    {/* ========================================================================= */}
    {/* 5. 2 SMALL CLICKABLE BANNERS                                              */}
    {/* ========================================================================= */}
    {sections.smallBanners?.enabled && (
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {/* Small Banner 1 */}
        <a
          href={sections.smallBanners.banner1?.link || '/shop'}
          class="group relative rounded-3xl overflow-hidden shadow-lg border border-slate-200/80 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white p-8 sm:p-10 flex flex-col justify-between min-h-[220px] transition-all hover:scale-[1.01] hover:shadow-xl"
        >
          <div class="absolute -right-12 -top-12 w-48 h-48 bg-indigo-500/20 rounded-full blur-2xl pointer-events-none group-hover:scale-150 transition-transform duration-700"></div>

          <div class="space-y-3 relative z-10">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 text-[10px] font-bold uppercase tracking-wider border border-indigo-400/30">
              <span class="material-symbols-outlined text-[14px]">percent</span>
              <span>{sections.smallBanners.banner1?.tag || 'Volume Slab Program'}</span>
            </div>

            <h3 class="font-display font-extrabold text-2xl sm:text-3xl text-white tracking-tight leading-tight">
              {sections.smallBanners.banner1?.title || 'Up to 35% Bulk Tier Discount'}
            </h3>

            <p class="text-xs text-slate-300 max-w-sm leading-relaxed">
              {sections.smallBanners.banner1?.description || 'Unlock volume price slabs on palletized orders with verified GST ITC invoices and dedicated credit limits.'}
            </p>
          </div>

          {sections.smallBanners.banner1?.image && (
            <img
              src={resolveMediaUrl(sections.smallBanners.banner1.image)}
              alt={sections.smallBanners.banner1?.title || 'Banner'}
              class="absolute right-0 bottom-0 max-w-[45%] max-h-[85%] object-contain opacity-35 group-hover:scale-105 transition-transform duration-500 pointer-events-none"
            />
          )}

          <div class="pt-4 flex items-center gap-2 text-xs font-bold text-indigo-300 group-hover:text-white transition-colors relative z-10">
            <span>{sections.smallBanners.banner1?.buttonText || 'Explore Bulk Slabs'}</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>

        {/* Small Banner 2 */}
        <a
          href={sections.smallBanners.banner2?.link || '/shipping-policy'}
          class="group relative rounded-3xl overflow-hidden shadow-lg border border-slate-200/80 bg-gradient-to-br from-slate-900 via-brand-950 to-slate-900 text-white p-8 sm:p-10 flex flex-col justify-between min-h-[220px] transition-all hover:scale-[1.01] hover:shadow-xl"
        >
          <div class="absolute -right-12 -top-12 w-48 h-48 bg-brand-500/20 rounded-full blur-2xl pointer-events-none group-hover:scale-150 transition-transform duration-700"></div>

          <div class="space-y-3 relative z-10">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-500/20 text-brand-300 text-[10px] font-bold uppercase tracking-wider border border-brand-400/30">
              <span class="material-symbols-outlined text-[14px]">local_shipping</span>
              <span>{sections.smallBanners.banner2?.tag || 'Logistics Hub WH-01'}</span>
            </div>

            <h3 class="font-display font-extrabold text-2xl sm:text-3xl text-white tracking-tight leading-tight">
              {sections.smallBanners.banner2?.title || 'Express 24-48h Cargo Dispatches'}
            </h3>

            <p class="text-xs text-slate-300 max-w-sm leading-relaxed">
              {sections.smallBanners.banner2?.description || 'Direct air & surface cargo dispatch from our Central Mumbai Node with real-time AWB airway bill tracking.'}
            </p>
          </div>

          {sections.smallBanners.banner2?.image && (
            <img
              src={resolveMediaUrl(sections.smallBanners.banner2.image)}
              alt={sections.smallBanners.banner2?.title || 'Banner'}
              class="absolute right-0 bottom-0 max-w-[45%] max-h-[85%] object-contain opacity-35 group-hover:scale-105 transition-transform duration-500 pointer-events-none"
            />
          )}

          <div class="pt-4 flex items-center gap-2 text-xs font-bold text-brand-300 group-hover:text-white transition-colors relative z-10">
            <span>{sections.smallBanners.banner2?.buttonText || 'Review Logistics SLAs'}</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>
      </section>
    )}

    {/* ========================================================================= */}
    {/* 6. TOP SELLING PRODUCTS                                                   */}
    {/* ========================================================================= */}
    {sections.topSellingProducts?.enabled && (
      <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-slate-200 pb-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-md bg-amber-100 text-amber-900 text-[10px] font-bold uppercase tracking-wider">
                {sections.topSellingProducts.badge || 'Best Sellers'}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            </div>
            <h2 class="text-xl sm:text-2xl font-display font-extrabold text-slate-900 tracking-tight">
              {sections.topSellingProducts.title || 'Top Selling Wholesale Hardware'}
            </h2>
            <p class="text-xs text-slate-500">
              {sections.topSellingProducts.subtitle || 'Highest-rated devices chosen by certified corporate buyers and retail chains across India.'}
            </p>
          </div>

          <a
            href={sections.topSellingProducts.viewAllLink || '/shop?sort=rating'}
            class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:text-brand-800 hover:underline transition-all self-start sm:self-auto"
          >
            <span>View All Top Sellers</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {topSellingProducts.map((product) => (
            <ProductCard client:load product={product} />
          ))}
        </div>
      </section>
    )}

    {/* ========================================================================= */}
    {/* 7. TRENDING PRODUCTS                                                      */}
    {/* ========================================================================= */}
    {sections.trendingProducts?.enabled && (
      <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-slate-200 pb-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-md bg-rose-100 text-rose-800 text-[10px] font-bold uppercase tracking-wider">
                {sections.trendingProducts.badge || 'Trending Now'}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
            </div>
            <h2 class="text-xl sm:text-2xl font-display font-extrabold text-slate-900 tracking-tight">
              {sections.trendingProducts.title || 'Trending Gear & Pro Equipment'}
            </h2>
            <p class="text-xs text-slate-500">
              {sections.trendingProducts.subtitle || 'High velocity trending peripherals, esports mice, and spatial audio studio gear.'}
            </p>
          </div>

          <a
            href={sections.trendingProducts.viewAllLink || '/shop'}
            class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:text-brand-800 hover:underline transition-all self-start sm:self-auto"
          >
            <span>View All Trending</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {trendingProducts.map((product) => (
            <ProductCard client:load product={product} />
          ))}
        </div>
      </section>
    )}

    {/* ========================================================================= */}
    {/* 8. FREE SHIPPING • SECURE PAYMENT • 24/7 SUPPORT                          */}
    {/* ========================================================================= */}
    {sections.trustBar?.enabled && (
      <section class="border-t border-slate-200 pt-10">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {/* Value Prop 1 */}
          <div class="p-6 rounded-3xl bg-white border border-slate-200/90 shadow-2xs space-y-3 hover:border-brand-300 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center group-hover:scale-105 transition-transform">
              <span class="material-symbols-outlined text-[26px]">local_shipping</span>
            </div>
            <div class="space-y-1">
              <h4 class="font-display font-bold text-slate-900 text-sm">
                {sections.trustBar.item1?.title || 'Free Interstate Shipping'}
              </h4>
              <p class="text-xs text-slate-500 leading-relaxed">
                {sections.trustBar.item1?.desc || 'Complimentary air & surface cargo logistics on all qualifying wholesale pallet orders.'}
              </p>
            </div>
          </div>

          {/* Value Prop 2 */}
          <div class="p-6 rounded-3xl bg-white border border-slate-200/90 shadow-2xs space-y-3 hover:border-emerald-300 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:scale-105 transition-transform">
              <span class="material-symbols-outlined text-[26px]">lock</span>
            </div>
            <div class="space-y-1">
              <h4 class="font-display font-bold text-slate-900 text-sm">
                {sections.trustBar.item2?.title || '100% Secure Payment Rails'}
              </h4>
              <p class="text-xs text-slate-500 leading-relaxed">
                {sections.trustBar.item2?.desc || 'Razorpay 256-bit SSL encryption, RTGS/NEFT wire transfer reconciliation, and Partial COD.'}
              </p>
            </div>
          </div>

          {/* Value Prop 3 */}
          <div class="p-6 rounded-3xl bg-white border border-slate-200/90 shadow-2xs space-y-3 hover:border-indigo-300 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:scale-105 transition-transform">
              <span class="material-symbols-outlined text-[26px]">support_agent</span>
            </div>
            <div class="space-y-1">
              <h4 class="font-display font-bold text-slate-900 text-sm">
                {sections.trustBar.item3?.title || 'Dedicated B2B Desk Support'}
              </h4>
              <p class="text-xs text-slate-500 leading-relaxed">
                {sections.trustBar.item3?.desc || 'Assigned sales executives and prompt technical assistance available via Phone, WhatsApp & Email.'}
              </p>
            </div>
          </div>

          {/* Value Prop 4 */}
          <div class="p-6 rounded-3xl bg-white border border-slate-200/90 shadow-2xs space-y-3 hover:border-purple-300 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center group-hover:scale-105 transition-transform">
              <span class="material-symbols-outlined text-[26px]">verified</span>
            </div>
            <div class="space-y-1">
              <h4 class="font-display font-bold text-slate-900 text-sm">
                {sections.trustBar.item4?.title || 'Verified OEM Warranty & GST'}
              </h4>
              <p class="text-xs text-slate-500 leading-relaxed">
                {sections.trustBar.item4?.desc || '100% authentic brand warranty coverage with automated GST Tax Invoices for ITC input credit.'}
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

  </div>
</ShopLayout>
