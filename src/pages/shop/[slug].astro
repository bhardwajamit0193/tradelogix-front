---
import ShopLayout from '../../layouts/ShopLayout.astro';
import ProductDetailView from '../../components/react/ProductDetailView.jsx';

const { slug } = Astro.params;
const formattedTitle = slug 
  ? `${slug.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')} | TradeLogix`
  : 'Product Details | TradeLogix';
---

<ShopLayout title={formattedTitle}>
  <ProductDetailView client:load initialSlug={slug} />
</ShopLayout>
