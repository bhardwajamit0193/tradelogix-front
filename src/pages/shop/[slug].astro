---
import ShopLayout from '../../layouts/ShopLayout.astro';
import { getProductBySlug, PRODUCTS } from '../../services/productService.js';
import AddToCartButton from '../../components/react/AddToCartButton.jsx';

const { slug } = Astro.params;
const product = getProductBySlug(slug) || PRODUCTS[0];
const relatedProducts = PRODUCTS.filter((p) => p.category === product.category && p.id !== product.id).slice(0, 3);
---

<ShopLayout title={`${product.name} | TradeLogix`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <a href="/shop" class="hover:text-slate-900">Shop</a>
      <span>/</span>
      <a href={`/shop?category=${product.category}`} class="hover:text-slate-900">{product.category}</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold truncate">{product.name}</span>
    </nav>

    <!-- Main Detail Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Gallery Showcase -->
      <div class="space-y-4">
        <div class="glass-panel p-4 rounded-3xl border border-slate-200/80 overflow-hidden bg-white shadow-sm">
          <img
            src={product.image}
            alt={product.name}
            onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&auto=format&fit=crop&q=80';"
            class="w-full h-[400px] sm:h-[480px] object-cover rounded-2xl"
          />
        </div>

        {product.gallery && product.gallery.length > 1 && (
          <div class="flex gap-4 overflow-x-auto pb-2">
            {product.gallery.map((imgUrl, idx) => (
              <button
                key={idx}
                class="w-20 h-20 rounded-xl overflow-hidden glass-panel border border-slate-200 shrink-0 hover:border-brand-500 transition-all bg-white"
              >
                <img src={imgUrl} alt={`${product.name} thumbnail ${idx}`} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Details & Actions -->
      <div class="space-y-6">
        <div>
          {product.badge && (
            <span class="px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-bold uppercase tracking-wider border border-brand-200">
              {product.badge}
            </span>
          )}
          <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-slate-900 tracking-tight mt-3">
            {product.name}
          </h1>

          <!-- Ratings & Stock -->
          <div class="flex items-center gap-4 mt-3 text-xs text-slate-500">
            <div class="flex items-center gap-1 text-amber-500 font-bold">
              <span>★</span>
              <span>{product.rating}</span>
              <span class="text-slate-400">({product.reviewCount} verified reviews)</span>
            </div>
            <span>•</span>
            <span class={`font-bold ${product.inStock ? 'text-emerald-600' : 'text-rose-600'}`}>
              {product.inStock ? `In Stock (${product.stockCount} available)` : 'Out of Stock'}
            </span>
          </div>
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          {product.description}
        </p>

        <!-- React Island: Variant Selector, Price Display & Add to Cart -->
        <div class="pt-4 border-t border-slate-200">
          <AddToCartButton client:load product={product} showVariantSelector={true} showPriceBox={true} />
        </div>

        <!-- Technical Specifications Table -->
        {product.specs && (
          <div class="pt-6 border-t border-slate-200 space-y-3">
            <h3 class="font-display font-bold text-base text-slate-900">Technical Specifications</h3>
            <div class="glass-panel rounded-2xl p-4 border border-slate-200 bg-white space-y-2 text-xs">
              {Object.entries(product.specs).map(([key, val]) => (
                <div key={key} class="flex justify-between py-1 border-b border-slate-100 last:border-0">
                  <span class="text-slate-500 font-medium">{key}</span>
                  <span class="text-slate-900 font-semibold">{val}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <div class="pt-16 border-t border-slate-200 space-y-8">
        <h2 class="font-display font-bold text-2xl text-slate-900">You Might Also Like</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {relatedProducts.map((rel) => (
            <div class="glass-panel glass-panel-hover rounded-3xl p-4 flex flex-col justify-between group bg-white border border-slate-200 shadow-sm">
              <a href={`/shop/${rel.slug}`} class="block overflow-hidden rounded-2xl mb-4 bg-slate-100">
                <img src={rel.image} alt={rel.name} class="w-full h-44 object-cover group-hover:scale-105 transition-transform" />
              </a>
              <h3 class="font-display font-semibold text-sm text-slate-900 truncate mb-2">{rel.name}</h3>
              <div class="flex items-center justify-between">
                <span class="font-bold text-slate-900 text-base">₹{rel.price.toFixed(2)}</span>
                <AddToCartButton client:load product={rel} compact={true} />
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</ShopLayout>
