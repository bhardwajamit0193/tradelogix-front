---
import ShopLayout from '../../layouts/ShopLayout.astro';
import { PRODUCTS, CATEGORIES } from '../../services/productService.js';
import ProductFilter from '../../components/react/ProductFilter.jsx';

const url = Astro.url;
const categoryParam = url.searchParams.get('category') || 'All';
---

<ShopLayout title="Shop Tech Catalog | TradeLogix Storefront">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8 ">
    <!-- Header Banner -->
    <div class="text-left mb-5 space-y-2 border-b border-slate-200 pb-6">
      <span class="px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-bold uppercase tracking-wider border border-brand-200">
        Hardware Catalog
      </span>
      <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-slate-900">Explore All Hardware & Electronics</h1>
      <p class="text-xs sm:text-sm text-slate-500 max-w-2xl">
        Filter through verified OEM laptops, curved OLED monitors, mechanical keyboards, and precision peripherals using the left sidebar controls.
      </p>
    </div>

    <!-- React Island: Dynamic Product Filter with Left Sidebar Layout -->
    <ProductFilter client:load initialProducts={PRODUCTS} categories={CATEGORIES} initialCategory={categoryParam} />
  </div>
</ShopLayout>
