---
import ShopLayout from '../../layouts/ShopLayout.astro';
import ProductFilter from '../../components/react/ProductFilter.jsx';

const url = Astro.url;
const categoryParam = url.searchParams.get('category') || 'All';
---

<ShopLayout title="Shop Tech Catalog | TradeLogix Storefront">
  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-6 sm:space-y-8 min-w-0">
    <!-- Header Banner -->
    <div class="text-left mb-2 sm:mb-5 space-y-2 border-b border-slate-200 pb-5 sm:pb-6">
      <span class="inline-block px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-[11px] sm:text-xs font-bold uppercase tracking-wider border border-brand-200">
        Hardware Catalog
      </span>
      <h1 class="font-display font-extrabold text-2xl sm:text-3xl lg:text-4xl text-slate-900 tracking-tight break-words">
        Explore All Hardware & Electronics
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 max-w-2xl leading-relaxed">
        Filter through verified OEM laptops, curved OLED monitors, mechanical keyboards, and precision peripherals.
      </p>
    </div>

    <!-- React Island: 100% Dynamic Product Filter with Skeleton Placeholders -->
    <ProductFilter client:load initialCategory={categoryParam} />
  </div>
</ShopLayout>
