---
import ShopLayout from '../layouts/ShopLayout.astro';
import CartDrawer from '../components/react/CartDrawer.jsx';
---

<ShopLayout title="Shopping Cart | TradeLogix Storefront">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="text-center max-w-xl mx-auto space-y-3">
      <span class="px-3 py-1 rounded-full bg-brand-500/10 text-brand-300 text-xs font-bold uppercase tracking-wider border border-brand-500/30">
        Review Items
      </span>
      <h1 class="font-display font-extrabold text-4xl text-white">Your Shopping Cart</h1>
      <p class="text-xs text-gray-400">Manage cart item quantities, apply discount codes, and proceed to checkout.</p>
    </div>

    <!-- Interactive Cart Overview & Checkout Trigger -->
    <div class="glass-panel p-8 sm:p-12 rounded-3xl max-w-2xl mx-auto text-center space-y-6 border border-white/10 shadow-2xl">
      <div class="w-16 h-16 rounded-full bg-brand-500/20 text-brand-400 flex items-center justify-center mx-auto border border-brand-500/30">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>

      <h2 class="font-display font-bold text-2xl text-white">Manage & Review Your Gear</h2>
      <p class="text-xs text-gray-400 max-w-md mx-auto">
        Your cart is synchronized across all sessions. Click below to open the interactive cart drawer or jump straight to checkout.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href="/shop"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gray-900 border border-white/10 text-gray-300 hover:text-white text-xs font-semibold"
        >
          Continue Shopping
        </a>
        <a
          href="/checkout"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl gradient-brand text-white font-semibold text-xs shadow-glow-primary hover:opacity-90 transition-all"
        >
          Proceed to Direct Checkout →
        </a>
      </div>
    </div>
  </div>
</ShopLayout>
