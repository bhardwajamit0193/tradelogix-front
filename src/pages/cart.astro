---
import ShopLayout from '../layouts/ShopLayout.astro';
import CartDrawer from '../components/react/CartDrawer.jsx';
---

<ShopLayout title="Shopping Cart | TradeLogix Storefront">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="text-center max-w-xl mx-auto space-y-3">
      <span class="px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-bold uppercase tracking-wider border border-brand-200">
        Review Items
      </span>
      <h1 class="font-display font-extrabold text-4xl text-slate-900">Your Shopping Cart</h1>
      <p class="text-xs text-slate-500">Manage cart item quantities, apply discount codes, and proceed to checkout.</p>
    </div>

    <!-- Interactive Cart Overview & Checkout Trigger -->
    <div class="glass-panel p-8 sm:p-12 rounded-3xl max-w-2xl mx-auto text-center space-y-6 border border-slate-200 bg-white shadow-xl">
      <div class="w-16 h-16 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center mx-auto border border-brand-200">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>

      <h2 class="font-display font-bold text-2xl text-slate-900">Manage & Review Your Gear</h2>
      <p class="text-xs text-slate-500 max-w-md mx-auto">
        Your cart is synchronized across all sessions. Click below to open the interactive cart drawer or jump straight to checkout.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href="/shop"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-700 hover:text-slate-900 text-xs font-semibold"
        >
          Continue Shopping
        </a>
        <a
          href="/checkout"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl gradient-brand text-white font-semibold text-xs shadow-md hover:opacity-90 transition-all"
        >
          Proceed to Direct Checkout →
        </a>
      </div>
    </div>
  </div>
</ShopLayout>
