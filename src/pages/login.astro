---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import UserAuthForm from '../components/react/UserAuthForm.jsx';
---

<BaseLayout title="User Sign In | TradeLogix">
  <div class="flex flex-col min-h-screen relative overflow-hidden bg-slate-50/50">
    <!-- Ambient Glowing Blobs -->
    <div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-brand-400/10 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 translate-x-1/2 translate-y-1/2 w-80 h-80 bg-pink-400/10 rounded-full blur-[100px] pointer-events-none"></div>

    <Navbar />
   <main class="flex-grow flex items-center justify-center p-4 py-20 relative z-10">
      <div class="backdrop-blur-xl bg-white/80 p-8 sm:p-10 rounded-[32px] max-w-md w-full border border-white/80 shadow-[0_24px_70px_-10px_rgba(15,23,42,0.08)]">
        <!-- React Island: Auth Form -->
        <UserAuthForm client:load />
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
