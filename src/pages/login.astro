---
import BaseLayout from '../layouts/BaseLayout.astro';
import UserAuthForm from '../components/react/UserAuthForm.jsx';
---

<BaseLayout title="B2B Customer Sign In & Registration | TradeLogix Wholesale" noindex={true}>
  <script is:inline>
    (function() {
      try {
        const saved = localStorage.getItem('tradelogix_user');
        if (saved) {
          const user = JSON.parse(saved);
          if (user && user.isLoggedIn) {
            const params = new URLSearchParams(window.location.search);
            const redirectUrl = params.get('redirect') || (user.role && user.role.toLowerCase() === 'admin' ? '/admin' : '/dashboard');
            window.location.replace(redirectUrl);
          }
        }
      } catch (e) {
        console.error(e);
      }
    })();
  </script>

  <div class="min-h-screen flex flex-col lg:flex-row bg-slate-50">
    <!-- ─── LEFT HERO PANEL: TRADELOGIX WHOLESALE B2B VALUE PROPOSITIONS ─── -->
    <div class="hidden lg:flex lg:w-1/2 bg-[#090e1a] text-white flex-col justify-between p-12 xl:p-16 relative overflow-hidden shrink-0 select-none min-h-screen">
      <!-- Ambient Glow Blobs -->
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-brand-600/25 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-orange-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-25 pointer-events-none"></div>

      <!-- Top Brand Header -->
      <div class="relative z-10">
        <a href="/" class="inline-flex items-center gap-3.5 group">
          <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform overflow-hidden p-1.5 border border-white/20">
            <img src="/logo.jpeg" alt="TradeLogix Wholesale Logo" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col">
            <span class="text-2xl font-extrabold tracking-tight font-display text-white group-hover:text-brand-300 transition-colors">TradeLogix</span>
            <span class="text-[10px] text-brand-300 font-bold tracking-widest uppercase">Wholesale B2B Platform</span>
          </div>
        </a>
      </div>

      <!-- Center Floating Glass Stats Card -->
      <div class="relative z-10 my-auto py-6">
        <div class="bg-[#111827]/90 backdrop-blur-xl border border-white/10 rounded-3xl p-7 shadow-2xl max-w-sm w-full space-y-6 hover:border-brand-500/40 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Depot Dispatch Volume</span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
              <svg class="w-3 h-3 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
              Live Wholesale Orders
            </span>
          </div>

          <div class="space-y-1">
            <div class="text-3xl xl:text-4xl font-extrabold text-white font-display tracking-tight">₹1,24,500+</div>
            <p class="text-[11px] text-slate-400">Direct B2B Tier Pricing & Multi-Depot Stock</p>
          </div>

          <!-- Bar Chart Graphic with highlighted Growth Bar -->
          <div class="flex items-end justify-between gap-3 pt-4 border-t border-white/5 h-28">
            <div class="flex-1 bg-slate-800 rounded-lg h-8 transition-all hover:bg-slate-700"></div>
            <div class="flex-1 bg-slate-800 rounded-lg h-14 transition-all hover:bg-slate-700"></div>
            <div class="flex-1 bg-slate-800 rounded-lg h-10 transition-all hover:bg-slate-700"></div>
            <div class="flex-1 bg-slate-800 rounded-lg h-18 transition-all hover:bg-slate-700"></div>
            <!-- Highlighted Brand Growth Bar -->
            <div class="flex-1 bg-gradient-to-t from-brand-600 via-indigo-500 to-cyan-400 rounded-lg h-24 shadow-lg shadow-brand-500/30 transition-all hover:scale-105"></div>
            <div class="flex-1 bg-slate-800 rounded-lg h-12 transition-all hover:bg-slate-700"></div>
          </div>
        </div>
      </div>

      <!-- Bottom Headline & Features matching Doc -->
      <div class="relative z-10 space-y-4">
        <div>
          <h1 class="text-3xl xl:text-4xl font-extrabold text-white font-display tracking-tight leading-tight">
            Empowering Modern<br />Wholesale Commerce
          </h1>
          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed max-w-md mt-2">
            TradeLogix is a verified B2B wholesale platform. Seamless depot dispatch, volume slab pricing, and automated GSTIN verification.
          </p>
        </div>

        <!-- Doc Functional Feature Tags -->
        <div class="flex flex-wrap gap-2 pt-1 text-[11px] font-medium text-slate-300">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white/5 border border-white/10">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Instant GSTIN Lookup
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white/5 border border-white/10">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span> Multi-Warehouse Dispatch
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white/5 border border-white/10">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span> Slab Tier Pricing
          </span>
        </div>
      </div>
    </div>

    <!-- ─── RIGHT FORM PANEL: B2B AUTH & ONBOARDING ─── -->
    <div class="w-full lg:w-1/2 flex flex-col justify-between min-h-screen bg-slate-50/70 p-6 sm:p-10 lg:p-12 relative overflow-y-auto">
      <!-- Top Navigation Link -->
      <div class="flex items-center justify-between w-full max-w-md mx-auto">
        <!-- Mobile Logo -->
        <a href="/" class="lg:hidden flex items-center gap-2">
          <img src="/logo.jpeg" alt="TradeLogix Logo" class="h-9 w-auto object-contain rounded-lg shadow-sm" />
          <div class="flex flex-col">
            <span class="font-bold text-slate-900 text-sm leading-none">TradeLogix</span>
            <span class="text-[9px] text-slate-500 font-semibold uppercase tracking-wider">Wholesale B2B</span>
          </div>
        </a>
        <div class="lg:ml-auto">
          <a
            href="/"
            class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors flex items-center gap-1 py-1.5 px-3 rounded-lg hover:bg-slate-100"
          >
            ← Back to Storefront
          </a>
        </div>
      </div>

      <!-- Main Floating Center Card -->
      <main class="my-auto py-8 w-full flex items-center justify-center">
        <div class="bg-white rounded-[28px] p-7 sm:p-10 max-w-md w-full border border-slate-200/80 shadow-[0_20px_60px_-15px_rgba(15,23,42,0.06)] space-y-6">
          <UserAuthForm client:load />
        </div>
      </main>

      <!-- Bottom Footer Info -->
      <div class="text-center text-[11px] text-slate-400 py-2 max-w-md mx-auto space-y-1">
        <div>TradeLogix Wholesale B2B Commerce Platform</div>
        <div>© 2026 TradeLogix Inc. All rights reserved.</div>
      </div>
    </div>
  </div>
</BaseLayout>
