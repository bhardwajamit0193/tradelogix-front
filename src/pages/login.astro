---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import UserAuthForm from '../components/react/UserAuthForm.jsx';
---

<BaseLayout title="User Sign In | TradeLogix">
  <div class="flex flex-col min-h-screen">
    <Navbar />
    <main class="flex-grow flex items-center justify-center p-4 py-16">
      <div class="glass-panel p-8 sm:p-12 rounded-3xl max-w-md w-full border border-white/10 shadow-2xl space-y-6">
        <div class="text-center space-y-2">
          <img
        src="/logo-white.png"
        alt="TradeLogix Logo"
        class="h-14 w-auto  object-contain  group-hover:scale-105 transition-transform mx-auto"
      />
         <h1 class="font-display font-bold text-2xl text-white pt-2">Sign In to TradeLogix</h1>
          <p class="text-xs text-gray-400">Enter your credentials to access your account</p>
        </div>

        <!-- React Island: Auth Form -->
        <UserAuthForm client:load />
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
