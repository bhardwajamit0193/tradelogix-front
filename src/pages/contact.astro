---
import ShopLayout from '../layouts/ShopLayout.astro';
import ContactHubView from '../components/react/ContactHubView.jsx';
import { fetchPageBySlugApi, parseContactSections } from '../services/pagesService.js';
import { fetchPlatformSettingsApi } from '../services/platformSettingsService.js';

let contactPage = null;
let platformSettings = null;

try {
  const [pageRes, settingsRes] = await Promise.all([
    fetchPageBySlugApi('contact'),
    fetchPlatformSettingsApi(),
  ]);
  contactPage = pageRes;
  platformSettings = settingsRes;
} catch (e) {
  // Fallback to defaults
}

const sections = parseContactSections(contactPage?.content);
const header = sections.header || {};
const departments = sections.departments || {};
const faqs = sections.faqs || {};

const pageTitle = contactPage?.metaTitle || 'Contact Us & Corporate Support Desk | TradeLogix Wholesale';
const pageDescription = contactPage?.metaDescription || 'Connect with TradeLogix Wholesale departments: Wholesale Sales, B2B Onboarding, GST Invoicing & Accounts, and Logistics & Dispatch Operations.';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:6543';
const resolveMediaUrl = (url) => {
  if (!url) return '';
  if (url.startsWith('/uploads/')) return `${API_URL}${url}`;
  return url;
};
---

<ShopLayout
  title={pageTitle}
  description={pageDescription}
  image={contactPage?.metaImage ? resolveMediaUrl(contactPage.metaImage) : undefined}
>
  <div class="space-y-16 py-10 sm:py-16">
    <!-- Header Banner -->
    {header.enabled !== false && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
        {header.badge && (
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-brand-600 animate-pulse"></span>
            <span>{header.badge}</span>
          </div>
        )}
        <h1 class="font-display font-black text-3xl sm:text-5xl text-slate-900 tracking-tight whitespace-pre-line">
          {header.title || 'Connect With TradeLogix Wholesale'}
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 max-w-2xl mx-auto leading-relaxed">
          {header.subtitle || 'Direct lines to our Wholesale Procurement Specialists, Dealer Onboarding Desk, GST Billing Team, and Central Mumbai Logistics Dock.'}
        </p>
      </section>
    )}

    <!-- Main Contact Hub Section (4 Department Cards + HQ Card + SLA Matrix) -->
    {departments.enabled !== false && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ContactHubView
          client:load
          departmentConfig={departments}
          platformSettings={platformSettings}
        />
      </section>
    )}

    <!-- Frequently Asked Questions (FAQ) Section -->
    {faqs.enabled !== false && Array.isArray(faqs.items) && faqs.items.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <div class="text-center space-y-2">
          {faqs.badge && (
            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-[11px] font-bold uppercase tracking-wider border border-slate-200">
              {faqs.badge}
            </span>
          )}
          <h2 class="text-2xl font-display font-bold text-slate-900">{faqs.title || 'Frequently Asked Questions'}</h2>
          <p class="text-xs text-slate-500">{faqs.subtitle || 'Common questions about TradeLogix B2B wholesale ordering, GST verification, and dispatch.'}</p>
        </div>

        <div class="space-y-4 text-xs">
          {faqs.items.map((faq) => (
            <details class="p-5 rounded-2xl bg-white border border-slate-200 group cursor-pointer shadow-2xs open:ring-1 open:ring-brand-500 transition-all">
              <summary class="font-bold text-slate-900 flex items-center justify-between list-none">
                <span>{faq.question}</span>
                <span class="material-symbols-outlined text-slate-400 group-open:rotate-180 transition-transform">expand_more</span>
              </summary>
              <p class="text-slate-600 mt-3 leading-relaxed pt-2 border-t border-slate-100 whitespace-pre-line">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}
  </div>
</ShopLayout>
