---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminLoginForm from '../../components/react/AdminLoginForm.jsx';
---

<BaseLayout title="Executive Secure Login | TradeLogix Studio" noindex={true}>
  <div class="flex flex-col min-h-screen">
    <!-- Main Center Panel -->
    <main class="flex-grow flex items-center justify-center p-4 py-24 relative overflow-hidden">
      <!-- Ambient Glow Decorators -->
      <div class="absolute -top-12 -left-12 w-64 h-64 bg-brand-500/10 rounded-full blur-3xl pointer-events-none animate-pulse-slow"></div>
      <div class="absolute -bottom-12 -right-12 w-64 h-64 bg-accent-violet/10 rounded-full blur-3xl pointer-events-none animate-pulse-slow"></div>

      <div class="glass-panel bg-white/90 p-8 sm:p-12 rounded-3xl max-w-md w-full border border-slate-200/80 shadow-2xl space-y-6 z-10">
        <div class="text-center space-y-3">
          <img
            src="/logo.jpeg"
            alt="TradeLogix Logo"
            class="h-12 w-auto object-contain rounded-lg mx-auto shadow-sm"
          />
          <div>
            <h1 class="font-display font-extrabold text-xl text-slate-900 tracking-tight">Executive Studio Login</h1>
            <p class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider mt-1">Authorized Personnel Only</p>
          </div>
        </div>

        <!-- React Island: Admin Credentials Form -->
        <AdminLoginForm client:load />

        <div className="text-center pt-2">
          <a href="/" className="text-[10px] text-slate-400 hover:text-slate-600 font-semibold transition-colors">
            ← Return to Public Storefront
          </a>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
