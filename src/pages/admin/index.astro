---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AnalyticsOverview from '../../components/react/AnalyticsOverview.jsx';
import { getOrders } from '../../services/orderService.js';

const recentOrders = getOrders().slice(0, 4);
---

<AdminLayout title="Admin Overview | TradeLogix Studio" headerTitle="Executive Dashboard" headerSubtitle="Real-time sales performance, active metrics, and recent order stream">
  <div class="space-y-8">
    <!-- React Island: Metrics Overview & Charts -->
    <AnalyticsOverview client:load />

    <!-- Recent Orders Snapshot -->
    <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-white/10 space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="font-display font-bold text-xl text-white">Recent Customer Orders</h3>
          <p class="text-xs text-gray-400">Latest incoming purchases awaiting fulfillment</p>
        </div>
        <a href="/admin/orders" class="text-xs font-semibold text-brand-400 hover:text-brand-300 flex items-center gap-1">
          Manage All Orders →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {recentOrders.map((ord) => (
          <div class="glass-panel p-4 rounded-2xl border border-white/5 space-y-2 text-xs">
            <div class="flex items-center justify-between">
              <span class="font-mono font-bold text-brand-400">{ord.id}</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-brand-500/20 text-brand-300 border border-brand-500/30">
                {ord.status}
              </span>
            </div>
            <p class="font-semibold text-white truncate">{ord.customerName}</p>
            <div class="flex items-center justify-between text-gray-400 pt-2 border-t border-white/5">
              <span>{ord.date}</span>
              <span class="font-display font-extrabold text-white text-sm">₹{ord.total.toFixed(2)}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>
