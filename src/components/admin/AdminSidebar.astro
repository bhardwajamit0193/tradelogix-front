---
const { currentPath = '/admin' } = Astro.props;

// Determine active section
const isProductsPage = currentPath.startsWith('/admin/products');
const isCouponsPage = currentPath.startsWith('/admin/coupons');
const isCustomersPage = currentPath.startsWith('/admin/users');
const isMediaPage = currentPath.startsWith('/admin/media');
const isWarehousesPage = currentPath.startsWith('/admin/warehouses');
const isSettingsPage = currentPath.startsWith('/admin/settings');

// Get active status parameter from Astro.url
const statusQuery = Astro.url.searchParams.get('status') || '';

const navItems = [
  { label: 'Overview', path: '/admin', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { label: 'Customer Orders', path: '/admin/orders', icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
];

const productSubItems = [
  { label: 'All Products',  path: '/admin/products' },
  { label: 'Add New',       path: '/admin/products/add' },
  { label: 'Categories',    path: '/admin/products/categories' },
  { label: 'Tags',          path: '/admin/products/tags' },
];

const couponSubItems = [
  { label: 'All Coupons',   path: '/admin/coupons' },
  { label: 'Add New',       path: '/admin/coupons/add' },
];

const mediaSubItems = [
  { label: 'Library',  path: '/admin/media' },
  { label: 'Add New',  path: '/admin/media/new' },
];

const warehouseSubItems = [
  { label: 'Warehouses',         path: '/admin/warehouses' },
  { label: 'All Products Stock', path: '/admin/warehouses/all-products' },
];

const customerSubItems = [
  { label: 'Pending Approval', status: 'pending', path: '/admin/users?status=pending' },
  { label: 'Approved Customers', status: 'approved', path: '/admin/users?status=approved' },
  { label: 'Rejected Profiles', status: 'rejected', path: '/admin/users?status=rejected' },
  { label: 'All Customers', status: 'all', path: '/admin/users?status=all' }
];

const settingsSubItems = [
  { label: 'Payment Settings', path: '/admin/settings/payments' },
];

const isCustomersListPage = currentPath === '/admin/users' || currentPath === '/admin/users/';

// Helper to determine if a specific child status is active
const isSubItemActive = (subStatus) => {
  if (!isCustomersListPage) return false;
  const normalizedQuery = statusQuery.toLowerCase();
  if (normalizedQuery === '' || normalizedQuery === 'pending' || normalizedQuery === 'pending approval') {
    return subStatus === 'pending';
  }
  if (normalizedQuery === 'approve' || normalizedQuery === 'approved') {
    return subStatus === 'approved';
  }
  return normalizedQuery === subStatus;
};
---

<!-- Mobile Drawer Backdrop Overlay -->
<div
  id="admin-sidebar-backdrop"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-40 hidden lg:hidden transition-opacity duration-300 opacity-0"
  aria-hidden="true"
></div>

<!-- Sidebar: Off-canvas drawer on mobile, static on desktop -->
<aside
  id="admin-sidebar"
  class="fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200 flex flex-col h-screen transform -translate-x-full lg:translate-x-0 lg:static lg:sticky lg:top-0 shrink-0 transition-transform duration-300 ease-in-out shadow-xl lg:shadow-none"
>
  <div class="p-5 sm:p-6 space-y-6 flex-1 overflow-y-auto custom-sidebar-scroll">
    <!-- Brand Header with Close Button on Mobile -->
    <div class="flex items-center justify-between">
      <a href="/admin" class="flex items-center gap-3">
        <img
          src="/logo.jpeg"
          alt="TradeLogix Logo"
          class="h-12 w-auto object-contain rounded-lg hover:scale-105 transition-transform"
        />
      </a>

      <button
        id="admin-sidebar-close-btn"
        type="button"
        class="lg:hidden p-2 rounded-xl text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors"
        aria-label="Close sidebar"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Menu -->
    <nav class="space-y-1.5">
      <p class="px-3 text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Main Menu</p>
      
      {navItems.map((item) => {
        const isActive = currentPath === item.path;
        return (
          <a
            href={item.path}
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
              isActive
                ? 'bg-brand-50 text-brand-600 font-semibold border-r-2 border-brand-600 shadow-sm'
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
            }`}
          >
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
            </svg>
            <span>{item.label}</span>
          </a>
        );
      })}

      <!-- Products Catalog Dropdown -->
      <details class="group select-none" open={isProductsPage}>
        <summary class={`flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold cursor-pointer list-none transition-all ${
          isProductsPage
            ? 'bg-brand-50 text-brand-600'
            : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
        }`}>
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <span>Products Catalog</span>
          </div>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="pl-7 mt-1.5 space-y-1 border-l-2 border-slate-100 ml-5">
          {productSubItems.map((subItem) => {
            const isSubActive = currentPath === subItem.path;
            return (
              <a
                href={subItem.path}
                class={`flex items-center justify-between px-3 py-2 rounded-lg text-[11px] font-medium transition-all ${
                  isSubActive
                    ? 'text-brand-600 bg-brand-50/50 font-semibold'
                    : 'text-slate-500 hover:text-slate-900 hover:pl-4'
                }`}
              >
                <span>{subItem.label}</span>
                {isSubActive && (
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shadow-glow-primary animate-pulse" />
                )}
              </a>
            );
          })}
        </div>
      </details>

      <!-- Coupons Dropdown Menu -->
      <details class="group select-none" open={isCouponsPage}>
        <summary class={`flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold cursor-pointer list-none transition-all ${
          isCouponsPage
            ? 'bg-brand-50 text-brand-600'
            : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
        }`}>
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
            </svg>
            <span>Coupons</span>
          </div>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="pl-7 mt-1.5 space-y-1 border-l-2 border-slate-100 ml-5">
          {couponSubItems.map((subItem) => {
            const isSubActive = currentPath === subItem.path;
            return (
              <a
                href={subItem.path}
                class={`flex items-center justify-between px-3 py-2 rounded-lg text-[11px] font-medium transition-all ${
                  isSubActive
                    ? 'text-brand-600 bg-brand-50/50 font-semibold'
                    : 'text-slate-500 hover:text-slate-900 hover:pl-4'
                }`}
              >
                <span>{subItem.label}</span>
                {isSubActive && (
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shadow-glow-primary animate-pulse" />
                )}
              </a>
            );
          })}
        </div>
      </details>

      <!-- Media Dropdown Menu -->
      <details class="group select-none" open={isMediaPage}>
        <summary class={`flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold cursor-pointer list-none transition-all ${
          isMediaPage
            ? 'bg-brand-50 text-brand-600'
            : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
        }`}>
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Media</span>
          </div>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="pl-7 mt-1.5 space-y-1 border-l-2 border-slate-100 ml-5">
          {mediaSubItems.map((subItem) => {
            const isSubActive = currentPath === subItem.path;
            return (
              <a
                href={subItem.path}
                class={`flex items-center justify-between px-3 py-2 rounded-lg text-[11px] font-medium transition-all ${
                  isSubActive
                    ? 'text-brand-600 bg-brand-50/50 font-semibold'
                    : 'text-slate-500 hover:text-slate-900 hover:pl-4'
                }`}
              >
                <span>{subItem.label}</span>
                {isSubActive && (
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shadow-glow-primary animate-pulse" />
                )}
              </a>
            );
          })}
        </div>
      </details>

      <!-- Warehouses Dropdown Menu -->
      <details class="group select-none" open={isWarehousesPage}>
        <summary class={`flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold cursor-pointer list-none transition-all ${
          isWarehousesPage
            ? 'bg-brand-50 text-brand-600'
            : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
        }`}>
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span>Warehouses</span>
          </div>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="pl-7 mt-1.5 space-y-1 border-l-2 border-slate-100 ml-5">
          {warehouseSubItems.map((subItem) => {
            const isSubActive = currentPath === subItem.path;
            return (
              <a
                href={subItem.path}
                class={`flex items-center justify-between px-3 py-2 rounded-lg text-[11px] font-medium transition-all ${
                  isSubActive
                    ? 'text-brand-600 bg-brand-50/50 font-semibold'
                    : 'text-slate-500 hover:text-slate-900 hover:pl-4'
                }`}
              >
                <span>{subItem.label}</span>
                {isSubActive && (
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shadow-glow-primary animate-pulse" />
                )}
              </a>
            );
          })}
        </div>
      </details>

      <!-- Customers Dropdown Menu -->
      <details class="group select-none" open={isCustomersPage}>
        <summary class={`flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold cursor-pointer list-none transition-all ${
          isCustomersPage
            ? 'bg-brand-50 text-brand-600'
            : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
        }`}>
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span>Customers</span>
          </div>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="pl-7 mt-1.5 space-y-1 border-l-2 border-slate-100 ml-5">
          {customerSubItems.map((subItem) => {
            const isSubActive = isSubItemActive(subItem.status);
            return (
              <a
                href={subItem.path}
                class={`flex items-center justify-between px-3 py-2 rounded-lg text-[11px] font-medium transition-all ${
                  isSubActive
                    ? 'text-brand-600 bg-brand-50/50 font-semibold'
                    : 'text-slate-500 hover:text-slate-900 hover:pl-4'
                }`}
              >
                <span>{subItem.label}</span>
                {isSubActive && (
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shadow-glow-primary animate-pulse" />
                )}
              </a>
            );
          })}
        </div>
      </details>

      <!-- Settings Dropdown Menu -->
      <details class="group select-none" open={isSettingsPage}>
        <summary class={`flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold cursor-pointer list-none transition-all ${
          isSettingsPage
            ? 'bg-brand-50 text-brand-600'
            : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
        }`}>
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Settings</span>
          </div>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="pl-7 mt-1.5 space-y-1 border-l-2 border-slate-100 ml-5">
          {settingsSubItems.map((subItem) => {
            const isSubActive = currentPath === subItem.path;
            return (
              <a
                href={subItem.path}
                class={`flex items-center justify-between px-3 py-2 rounded-lg text-[11px] font-medium transition-all ${
                  isSubActive
                    ? 'text-brand-600 bg-brand-50/50 font-semibold'
                    : 'text-slate-500 hover:text-slate-900 hover:pl-4'
                }`}
              >
                <span>{subItem.label}</span>
                {isSubActive && (
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-500 shadow-glow-primary animate-pulse" />
                )}
              </a>
            );
          })}
        </div>
      </details>
    </nav>
  </div>

  <!-- Bottom Return Button -->
  <div class="p-4 sm:p-5 border-t border-slate-200 bg-white shrink-0 mt-auto">
    <a
      href="/"
      class="flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:text-slate-900 text-xs font-semibold hover:bg-slate-100 transition-all shadow-sm"
    >
      <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Storefront
    </a>
  </div>
</aside>

<script is:inline>
  (function() {
    function initSidebarToggle() {
      const menuBtn = document.getElementById('admin-mobile-menu-btn');
      const closeBtn = document.getElementById('admin-sidebar-close-btn');
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('admin-sidebar-backdrop');

      function openSidebar() {
        if (!sidebar || !backdrop) return;
        sidebar.classList.remove('-translate-x-full');
        sidebar.classList.add('translate-x-0');
        backdrop.classList.remove('hidden');
        setTimeout(() => backdrop.classList.remove('opacity-0'), 10);
        document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
      }

      function closeSidebar() {
        if (!sidebar || !backdrop) return;
        sidebar.classList.add('-translate-x-full');
        sidebar.classList.remove('translate-x-0');
        backdrop.classList.add('opacity-0');
        setTimeout(() => backdrop.classList.add('hidden'), 300);
        document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
      }

      if (menuBtn) menuBtn.onclick = openSidebar;
      if (closeBtn) closeBtn.onclick = closeSidebar;
      if (backdrop) backdrop.onclick = closeSidebar;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSidebarToggle);
    } else {
      initSidebarToggle();
    }
  })();
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary {
    list-style: none;
  }
  .custom-sidebar-scroll {
    scrollbar-width: thin;
    scrollbar-color: #e2e8f0 transparent;
  }
  .custom-sidebar-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .custom-sidebar-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-sidebar-scroll::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 9999px;
  }
</style>
