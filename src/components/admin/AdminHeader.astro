---
import UserMenuDropdown from '../react/UserMenuDropdown.jsx';

export interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle = 'Real-time store metrics and management controls' } = Astro.props;
---

<header class="glass-nav sticky top-0 z-30 px-4 sm:px-6 lg:px-8 py-3.5 sm:py-5 flex items-center justify-between border-b border-slate-200">
  <div class="flex items-center gap-3 min-w-0">
    <!-- Mobile Hamburger Toggle Button -->
    <button
      id="admin-mobile-menu-btn"
      type="button"
      class="lg:hidden p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors focus:outline-none shrink-0"
      aria-label="Open sidebar menu"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <div class="min-w-0">
      <h1 class="font-display font-bold text-lg sm:text-2xl text-slate-900 tracking-tight truncate">{title}</h1>
      <p class="text-xs text-slate-500 mt-0.5 truncate hidden sm:block">{subtitle}</p>
    </div>
  </div>

  <div class="flex items-center gap-2 sm:gap-4 shrink-0">
    <!-- User Menu Island -->
    <UserMenuDropdown client:load />
  </div>
</header>
