---
import UserMenuDropdown from '../react/UserMenuDropdown.jsx';

export interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle = 'Real-time store metrics and management controls' } = Astro.props;
---

<header class="glass-nav sticky top-0 z-30 px-8 py-5 flex items-center justify-between border-b border-white/10">
  <div>
    <h1 class="font-display font-bold text-2xl text-white tracking-tight">{title}</h1>
    <p class="text-xs text-gray-400 mt-0.5">{subtitle}</p>
  </div>

  <div class="flex items-center gap-4">
    <!-- Live Status Pill -->
    <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      System Online (v1.0)
    </div>

    <!-- Notification Bell -->
    <button class="p-2.5 rounded-xl bg-gray-900 border border-white/10 text-gray-400 hover:text-white hover:border-white/20 transition-all relative">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-brand-500"></span>
    </button>

    <!-- User Menu Island -->
    <UserMenuDropdown client:load />
  </div>
</header>
