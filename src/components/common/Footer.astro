---
import FooterView from '../react/FooterView.jsx';
import { fetchFooterSettingsApi, DEFAULT_FOOTER_SETTINGS } from '../../services/platformSettingsService.js';

let footer = DEFAULT_FOOTER_SETTINGS;
try {
  const data = await fetchFooterSettingsApi();
  if (data && typeof data === 'object') {
    footer = data;
  }
} catch (e) {
  // Fallback to default
}
---

<FooterView client:load initialData={footer} />
