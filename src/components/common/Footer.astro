<footer class="bg-slate-100/90 border-t border-slate-200 w-full py-16 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-5 gap-10">
    <!-- Brand Column -->
    <div class="space-y-4">
      <a class="font-display font-bold text-2xl text-slate-900 flex items-center gap-3" href="/">
        
      <img
        src="/logo.jpeg"
        alt="TradeLogix Logo"
        class="h-14 w-auto object-contain rounded-lg group-hover:scale-105 transition-transform"
      />
    
 
      </a>
      <p class="text-xs text-slate-500 leading-relaxed">
        Empowering global B2B & retail commerce with scalable hardware solutions and verified OEM partnerships.
      </p>
      
    </div>

    <!-- Quick Links Column -->
    <div>
      <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">Quick Links</h4>
      <ul class="space-y-2.5 text-xs text-slate-500">
        <li><a class="hover:text-brand-600 transition-colors" href="/shop">Bulk Hardware</a></li>
        <li><a class="hover:text-brand-600 transition-colors" href="/shop">OEM Partners</a></li>
        <li><a class="hover:text-brand-600 transition-colors" href="/shop">In-Stock Catalog</a></li>
        <li><a class="hover:text-brand-600 transition-colors" href="/admin">Admin Studio</a></li>
      </ul>
    </div>

    <!-- Categories Column -->
    <div>
      <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">Categories</h4>
      <ul class="space-y-2.5 text-xs text-slate-500">
        <li><a class="hover:text-brand-600 transition-colors" href="/shop?category=Audio">Audio & Headphones</a></li>
        <li><a class="hover:text-brand-600 transition-colors" href="/shop?category=Displays">Curved OLED Displays</a></li>
        <li><a class="hover:text-brand-600 transition-colors" href="/shop?category=Peripherals">Keyboards & Mice</a></li>
        <li><a class="hover:text-brand-600 transition-colors" href="/shop?category=Wearables">Smart Wearables</a></li>
      </ul>
    </div>

    <!-- Support Column -->
    <div>
      <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">Support</h4>
      <ul class="space-y-2.5 text-xs text-slate-500">
        <li><a class="hover:text-brand-600 transition-colors" href="/checkout">Corporate Contact</a></li>
        <li><a class="hover:text-brand-600 transition-colors" href="/cart">Bulk Discount Inquiry</a></li>
        <li><a class="hover:text-brand-600 transition-colors" href="#">Privacy Policy</a></li>
        <li><a class="hover:text-brand-600 transition-colors" href="#">Terms of Sale</a></li>
      </ul>
    </div>

    <!-- Contact Column -->
    <div>
      <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">Contact</h4>
      <ul class="space-y-3 text-xs text-slate-500">
        <li class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px] text-brand-600">mail</span>
          <span>sales@tradelogix.com</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px] text-brand-600">phone</span>
          <span>1-800-555-0199</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px] text-brand-600">location_on</span>
          <span>Global HQ</span>
        </li>
      </ul>
    </div>
  </div>
  <div class="text-xs text-center text-slate-400 pt-6 mt-8 border-t border-slate-200 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    © {new Date().getFullYear()} TradeLogix Wholesale Commerce. All rights reserved.
  </div>
</footer>
