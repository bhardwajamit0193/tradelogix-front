---
import CartBadgeTrigger from '../react/CartBadgeTrigger.jsx';
import UserMenuDropdown from '../react/UserMenuDropdown.jsx';
import NavbarSearch from '../react/NavbarSearch.jsx';
---

<header class="glass-nav sticky top-0 z-50 border-b border-slate-200/80 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-20 gap-3 sm:gap-4">
    <!-- Brand Logo using logo.jpeg -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <img
        src="/logo.jpeg"
        alt="TradeLogix Logo"
        class="h-12 sm:h-14 w-auto object-contain rounded-lg group-hover:scale-105 transition-transform"
      />
    </a>

    <!-- Dynamic Integrated Search Bar with live /api/all-categories -->
    <NavbarSearch client:load />

    <!-- Trailing Actions (Cart & User Account Islands matching docs/home.html) -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Cart Island -->
      <CartBadgeTrigger client:load />

      <!-- User Account Island -->
      <UserMenuDropdown client:load />
    </div>
  </div>
</header>
