---
import { Image } from 'astro:assets';
import logoImg from '../../assets/logo.jpeg';
import CartBadgeTrigger from '../react/CartBadgeTrigger.jsx';
import UserMenuDropdown from '../react/UserMenuDropdown.jsx';
import NavbarSearch from '../react/NavbarSearch.jsx';
---

<header class="glass-nav sticky top-0 z-50 border-b border-slate-200/80 shadow-xs bg-white/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
    <!-- Main Top Row: Logo, Search (Desktop), Cart & Account -->
    <div class="flex items-center justify-between h-16 sm:h-20 gap-2 sm:gap-4">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2 group shrink-0" aria-label="TradeLogix Home">
        <Image
          src={logoImg}
          alt="TradeLogix Logo"
          loading="eager"
          class="h-9 sm:h-11 md:h-13 w-auto max-w-[135px] sm:max-w-[180px] object-contain rounded-lg group-hover:scale-105 transition-transform"
        />
      </a>

      <!-- Desktop Integrated Search Bar -->
      <div class="hidden md:flex flex-1 max-w-xl mx-4 lg:mx-8 min-w-0">
        <NavbarSearch client:load />
      </div>

      <!-- Trailing Actions (Cart Island & User Account Dropdown) -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <CartBadgeTrigger client:load />
        <UserMenuDropdown client:load />
      </div>
    </div>

    <!-- Mobile Dedicated Search Row (Full width, zero squishing on mobile) -->
    <div class="md:hidden pb-3 pt-0.5 w-full">
      <NavbarSearch client:load />
    </div>
  </div>
</header>
