---
const { currentPath = '/dashboard' } = Astro.props;

const navItems = [
  {
    label: 'Overview',
    path: '/dashboard',
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  },
  {
    label: 'My Purchase Orders',
    path: '/dashboard/orders',
    icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  },
  {
    label: 'Business Profile',
    path: '/dashboard/profile',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
  {
    label: 'Shipping & Billing',
    path: '/dashboard/addresses',
    icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    label: 'Change Login Mobile',
    path: '/dashboard/change-phone',
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
];
---

<!-- Mobile Drawer Backdrop Overlay -->
<div
  id="customer-sidebar-backdrop"
  class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-40 hidden lg:hidden transition-opacity duration-300 opacity-0"
  aria-hidden="true"
></div>

<!-- Sidebar: Off-canvas drawer on mobile, static on desktop -->
<aside
  id="customer-sidebar"
  class="fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200 flex flex-col h-screen transform -translate-x-full lg:translate-x-0 lg:static lg:sticky lg:top-0 shrink-0 transition-transform duration-300 ease-in-out shadow-xl lg:shadow-none"
>
  <div class="p-5 sm:p-6 space-y-6 flex-1 overflow-y-auto custom-sidebar-scroll">
    <!-- Brand Header with Close Button on Mobile -->
    <div class="flex items-center justify-between">
      <a href="/dashboard" class="flex items-center gap-3">
        <img
          src="/logo.jpeg"
          alt="TradeLogix Logo"
          class="h-12 w-auto object-contain rounded-lg hover:scale-105 transition-transform"
        />
      </a>

      <button
        id="customer-sidebar-close-btn"
        type="button"
        class="lg:hidden p-2 rounded-xl text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors"
        aria-label="Close sidebar"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Menu -->
    <nav class="space-y-1.5">
      <p class="px-3 text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Customer Portal</p>

      {navItems.map((item) => {
        const isActive =
          item.path === '/dashboard'
            ? currentPath === '/dashboard'
            : currentPath.startsWith(item.path);

        return (
          <a
            href={item.path}
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
              isActive
                ? 'bg-brand-50 text-brand-600 font-semibold border-r-2 border-brand-600 shadow-sm'
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
            }`}
          >
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
            </svg>
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Bottom Navigation Actions -->
  <div class="p-4 sm:p-5 border-t border-slate-200 bg-white shrink-0 mt-auto space-y-2">
    <a
      href="/shop"
      class="flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl gradient-brand text-white text-xs font-bold shadow-md hover:opacity-95 transition-all"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      Browse Wholesale Store
    </a>

    <a
      href="/"
      class="flex items-center justify-center gap-2 w-full py-2 px-4 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:text-slate-900 text-xs font-semibold hover:bg-slate-100 transition-all shadow-sm"
    >
      <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Storefront
    </a>
  </div>
</aside>

<script is:inline>
  (function() {
    function initCustomerSidebar() {
      const menuBtn = document.getElementById('customer-mobile-menu-btn');
      const closeBtn = document.getElementById('customer-sidebar-close-btn');
      const sidebar = document.getElementById('customer-sidebar');
      const backdrop = document.getElementById('customer-sidebar-backdrop');

      function openSidebar() {
        if (!sidebar || !backdrop) return;
        sidebar.classList.remove('-translate-x-full');
        sidebar.classList.add('translate-x-0');
        backdrop.classList.remove('hidden');
        setTimeout(() => backdrop.classList.remove('opacity-0'), 10);
        document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
      }

      function closeSidebar() {
        if (!sidebar || !backdrop) return;
        sidebar.classList.add('-translate-x-full');
        sidebar.classList.remove('translate-x-0');
        backdrop.classList.add('opacity-0');
        setTimeout(() => backdrop.classList.add('hidden'), 300);
        document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
      }

      if (menuBtn) menuBtn.onclick = openSidebar;
      if (closeBtn) closeBtn.onclick = closeSidebar;
      if (backdrop) backdrop.onclick = closeSidebar;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCustomerSidebar);
    } else {
      initCustomerSidebar();
    }
    document.addEventListener('astro:page-load', initCustomerSidebar);
  })();
</script>

<style>
  .custom-sidebar-scroll {
    scrollbar-width: thin;
    scrollbar-color: #e2e8f0 transparent;
  }
  .custom-sidebar-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .custom-sidebar-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-sidebar-scroll::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 9999px;
  }
</style>
